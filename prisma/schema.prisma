// Datasource: placeholder for Supabase Postgres
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  websites  Website[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A library of template blueprints curated by you
model Template {
  id          String        @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  theme       Json          // theme object used by builder
  blocks      TemplateBlock[]
  websites    Website[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TemplateBlock {
  id         String   @id @default(cuid())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  type       String   // BlockType string
  position   Int
  config     Json     // per-block configuration
}

// A concrete website created/owned by a user (optionally from a Template)
model Website {
  id          String        @id @default(cuid())
  eventId     String        @unique // Comeet encrypted event ID — primary lookup key
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  name        String
  slug        String        @unique
  theme       Json
  template    Template?     @relation(fields: [templateId], references: [id])
  templateId  String?
  blocks      WebsiteBlock[]
  published   Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model WebsiteBlock {
  id        String   @id @default(cuid())
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  websiteId String
  type      String   // BlockType string
  position  Int
  config    Json
}


